{
  "manifest_version": 3,
  "name": "Dashboard",
  "version": "1.0",
  "description": "Custom New Tab Dashboard",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "system.cpu",
    "system.memory"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}